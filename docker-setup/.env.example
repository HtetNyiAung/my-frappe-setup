# Project Configuration
STACK_ID=frappe-v16-stack
CUSTOM_IMAGE=my-learning-frappe:v16
FRAPPE_BRANCH=version-16
COMPOSE_FILE=pwd-with-apps.yml
BACKEND_CONTAINER=docker-setup-backend-1
SITE_DOMAIN=frontend
PUBLIC_URL=https://lms.inyaland.com

# Optional GitHub token for entries marked "private": true in apps.json.
# Use a fine-grained token with read-only Contents access to the required repos.
# Keep the token only in .env; never put it in apps.json or a repository URL.
GITHUB_TOKEN=

# Production Safety
# This is an operational guard used by production.sh, not a built-in Frappe mode.
DEPLOYMENT_MODE=development
# Set REQUIRE_PRODUCTION_READY=1 to block setup when unsafe defaults are present.
REQUIRE_PRODUCTION_READY=0
# Optional per-site HTTP request limit. Leave both empty to keep Frappe defaults.
FRAPPE_RATE_LIMIT=
FRAPPE_RATE_LIMIT_WINDOW=
AUTO_BACKUP_BEFORE_SETUP=1
REQUIRE_BACKUP_BEFORE_SETUP=0
# Delete host backup folders older than this many days.
BACKUP_RETENTION_DAYS=14
# Keep this many complete backup sets in the Frappe container.
CONTAINER_BACKUP_KEEP_COUNT=3
# Upload verified backup sets to S3 when S3_STORAGE_ENABLED is also true.
S3_BACKUP_UPLOAD_ENABLED=false
S3_BACKUP_BUCKET_NAME=app-backups
S3_BACKUP_PREFIX=frappe-backups
S3_BACKUP_RETENTION_DAYS=30
# Delete operational script logs older than this many days.
SCRIPT_LOG_RETENTION_DAYS=30
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5

# Branding Configuration
PROJECT_NAME="My Learning Frappe"
PRIMARY_COLOR="#0f766e"
SYSTEM_LANGUAGE=en
SYSTEM_TIME_ZONE=Asia/Yangon

# Port Configuration
FRAPPE_PORT=8787
FRAPPE_INTERNAL_PORT=8080
BIND_ADDRESS=0.0.0.0

# Database Configuration
# Use "local" for the Compose MariaDB service or "external" for a separate server.
DATABASE_MODE=local
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=admin
MARIADB_ROOT_PASSWORD=admin
DB_ROOT_USERNAME=root
# Used for external database administration; local mode falls back to MYSQL_ROOT_PASSWORD.
DB_ROOT_PASSWORD=
# External credential repair is disabled unless explicitly enabled.
ALLOW_EXTERNAL_DB_CREDENTIAL_REPAIR=false
# Optional: custom MariaDB database name for a new site (leave empty for Frappe default)
DB_NAME=
DB_PASSWORD=admin

# Admin Configuration
ADMIN_PASSWORD=admin

# Keycloak Configuration
KC_RUN_MODE=start-dev  # Change to 'start' for production
KC_DB_PASSWORD=keycloak_db_password
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin
KC_HOSTNAME=localhost # Change to your domain in production
KC_PORT=8686

# Authentik Configuration
AUTHENTIK_PORT=9000
AUTHENTIK_HTTPS_PORT=9443
AUTHENTIK_DB_PASSWORD=authentik_db_password
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_USER=authentik
# RUN: openssl rand -base64 64 | tr -d '\n' to generate a secret key
AUTHENTIK_SECRET_KEY=yoursecretkey_replacethis
AUTHENTIK_TAG=2024.12.3
AUTHENTIK_BOOTSTRAP_PASSWORD=admin
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com

# MinIO S3 Object Storage Configuration
S3_STORAGE_ENABLED=false
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=ChangeThisStrongPassword123!
S3_REGION=us-east-1
S3_BUCKET_NAME=app-public
# Reserved for a future two-bucket integration; frappe_s3_attachment does not use it.
S3_PRIVATE_BUCKET_NAME=app-private
